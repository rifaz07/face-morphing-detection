PROJECT_NAME=Face Morphing Detection API
API_V1_PREFIX=/api/v1
VERSION=0.1.0
ENV=development

# Database — inside Docker the host is the container name, not localhost
DATABASE_URL=postgresql://fmd_user:CHANGE_ME@fmd-postgres:5432/face_morphing_db

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
