# ============================================================
# FACE MORPHING DETECTION — Environment Variables Template
# Copy this file to .env.local (frontend) or .env (backend)
# NEVER commit real secrets — this file is safe to commit
# ============================================================


# ============================================================
# CLERK — Authentication (https://clerk.com)
# ============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard


# ============================================================
# SUPABASE — Database (https://supabase.com)
# ============================================================
# Used by Prisma (Next.js) and SQLAlchemy (FastAPI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase project credentials (optional — for direct client use)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx


# ============================================================
# CLOUDINARY — Image Storage & CDN (https://cloudinary.com)
# ============================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDINARY_UPLOAD_PRESET=face_morphing_uploads


# ============================================================
# FASTAPI BACKEND — ML API
# ============================================================
# URL where the FastAPI server is running
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend-side Cloudinary (same values, no NEXT_PUBLIC prefix)
CLOUDINARY_CLOUD_NAME=your_cloud_name

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app


# ============================================================
# SENTRY — Error Tracking (https://sentry.io)
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=face-morphing-frontend
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backend Sentry
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0


# ============================================================
# APP CONFIG
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Python / FastAPI
ENVIRONMENT=development
LOG_LEVEL=debug
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
